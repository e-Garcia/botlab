<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A real app that wants to spot suspicious apps enumerates packages; this lets freeRASP's malware scan see them. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <!-- Any app can ask which installed apps declare an accessibility service, with no special permission. -->
        <intent>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent>
        <package android:name="ga.egarcia.harness" />
    </queries>

    <application
        android:name=".BotLabApp"
        android:allowBackup="false"
        android:label="Bot Lab"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".ui.BotLabActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Developer control from adb only (DUMP is held by the adb shell). -->
        <receiver
            android:name=".ControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ga.egarcia.botlab.RESET" />
                <action android:name="ga.egarcia.botlab.SAVE" />
                <action android:name="ga.egarcia.botlab.RASP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
